# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=findx
POSTGRES_PASSWORD=findx_secret
POSTGRES_DB=findx_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=findx_db
DB_USER=findx
DB_PASSWORD=findx_secret

# ─── JWT ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Change these in production — must be at least 32 characters
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=900      # seconds (15 minutes)
JWT_REFRESH_EXPIRES_IN=604800  # seconds (7 days)

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
